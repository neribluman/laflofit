# Copy this file to .env.local, then run: npm run db:setup

# From Vercel: your project -> Storage -> Neon Postgres -> connection string.
# It is long and starts with postgresql://
DATABASE_URL=postgresql://YOUR-CONNECTION-STRING-HERE

# npm run db:setup generates AUTH_SECRET for you and appends it below.
# On Vercel, add the same variables in Settings -> Environment Variables.

# Optional. Without it the app works fine, you just lose the "tell me about
# your day" box and tick everything by hand.
# Get one at console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5. Set to claude-haiku-4-5 for a cheaper,
# faster read that is a bit more literal-minded.
# ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Optional: logging over WhatsApp.
#
# Leave these unset and nothing changes — the card simply doesn't appear.
# Setup is in the README under "Logging over WhatsApp".
# ---------------------------------------------------------------------------

# Meta -> WhatsApp -> API Setup. The long-lived System User token, not the
# 24-hour test one, or the bot goes quiet after a day.
# WHATSAPP_TOKEN=EAAG...

# On the same screen, under the number you're sending from.
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Meta -> App Settings -> Basic -> App Secret. Every webhook is signed with
# this; without it the endpoint refuses everything, which is the safe default.
# WHATSAPP_APP_SECRET=...

# Any string you invent. You type it into Meta's webhook form and it echoes it
# back once to prove the URL is yours.
# WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string

# The bot's own number, digits only, with country code. This one is public —
# it goes in the "Open WhatsApp" link on the Me tab.
# NEXT_PUBLIC_WHATSAPP_NUMBER=15550001111

# Optional. Meta retires Graph versions on a schedule; bump this when they do.
# WHATSAPP_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Alternative to the block above: Twilio instead of Meta directly.
#
# Set these *or* the WHATSAPP_* ones, not both. Twilio's sandbox needs no Meta
# developer account at all — each person texts a join code to a shared number
# once. Webhook goes to /api/whatsapp/twilio.
# ---------------------------------------------------------------------------

# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# The sandbox number Twilio gives you, or your own once approved.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Only if the URL Twilio calls differs from what the app sees behind the proxy
# — signature checks fail with a confusing 401 when it does.
# TWILIO_WEBHOOK_URL=https://your-domain/api/whatsapp/twilio

# Still needed with Twilio: the number people text, digits only, for the
# "Open WhatsApp" link on the Me tab.
# NEXT_PUBLIC_WHATSAPP_NUMBER=14155238886

# ---------------------------------------------------------------------------
# Optional: a cheaper model for some jobs.
#
# Every model call goes through src/lib/llm.ts, and each job can be pointed at
# a different model. Anything left unset uses Claude, so an empty section here
# behaves exactly as before.
#
#   <provider>/<model>   e.g. groq/llama-3.3-70b-versatile
#
# Providers: groq, together, openrouter, deepinfra, fireworks, cerebras,
# ollama (local), custom (set LLM_BASE_URL), anthropic.
#
# Compare before you switch — the failure mode is a plausible wrong number,
# not an error:
#   npx tsx --conditions=react-server scripts/compare-models.mts \
#     anthropic/claude-opus-5 groq/llama-3.3-70b-versatile
# ---------------------------------------------------------------------------

# The hard one: free text into meals, macros, lifts and rule ticks. A mistake
# here is written into someone's diary and stays. Change this one last.
# LLM_INTERPRET_DAY=anthropic/claude-opus-5

# Reading a photograph of a plate. Open models are weakest at vision.
# LLM_INTERPRET_PLATE=anthropic/claude-opus-5

# Is this WhatsApp message a log or a question? Nearly trivial, and a mistake
# costs one confused reply. The obvious first thing to move.
# LLM_INTENT=groq/llama-3.3-70b-versatile

# Building a plan from a description. Occasional, so barely worth optimising.
# LLM_PLAN_REQUEST=anthropic/claude-opus-5

# Writing. Cheap models are noticeably worse at being funny, and these are the
# parts people actually read out to each other.
# LLM_ROAST=anthropic/claude-opus-5
# LLM_RECAP=anthropic/claude-opus-5

# Health-adjacent advice. Leave this one alone.
# LLM_PLAN_REVIEW=anthropic/claude-opus-5

# The easy one: OpenRouter carries most open models behind a single key, so
# LLM_INTENT=openrouter/moonshotai/kimi-k2 needs no Moonshot account.
# OPENROUTER_API_KEY=sk-or-v1-...

# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# DEEPINFRA_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
